# =============================================================================
# .env.example — placeholder template for .env
# =============================================================================
# To use: copy this file to `.env` and fill in real values.
#
#   cp .env.example .env       # macOS / Linux
#   Copy-Item .env.example .env   # Windows PowerShell
#
# The real `.env` is gitignored. Never commit secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<choose-a-strong-password>
POSTGRES_DB=patientdb
POSTGRES_PORT=5432

# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above.
# Hostname `postgres` resolves only inside the docker-compose network.
DB_CONN=Host=postgres;Port=5432;Database=patientdb;Username=postgres;Password=<same-as-POSTGRES_PASSWORD>


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_CONN=redis:6379


# -----------------------------------------------------------------------------
# Kafka + Zookeeper
# -----------------------------------------------------------------------------
ZOOKEEPER_PORT=2181
KAFKA_PORT_INTERNAL=9092
KAFKA_PORT_EXTERNAL=9094
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_UI_PORT=8080


# -----------------------------------------------------------------------------
# JWT signing key
# -----------------------------------------------------------------------------
# Generate a strong random key (PowerShell):
#   $b = [byte[]]::new(48)
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
#
# Or on macOS/Linux:
#   openssl rand -base64 48
JWT_SECRET=<paste-base64-of-at-least-48-random-bytes>


# -----------------------------------------------------------------------------
# AI / LLM (Ollama)
# -----------------------------------------------------------------------------
AI_ENDPOINT=http://host.docker.internal:11434/api/generate
AI_MODEL=llama3


# -----------------------------------------------------------------------------
# Service & observability ports (host-side)
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=4004
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
