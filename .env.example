# =============================================================================
# .env.example — placeholder template for .env
# =============================================================================
# To use: copy this file to `.env` and fill in real values.
#
#   cp .env.example .env             # macOS / Linux
#   Copy-Item .env.example .env      # Windows PowerShell
#
# The real `.env` is gitignored. Never commit secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# Postgres credentials (shared across all 3 service databases)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<choose-a-strong-password>

# Each service has its own database
AUTH_DB=patientflow_auth
PATIENT_DB=patientflow_patient
BILLING_DB=patientflow_billing


# -----------------------------------------------------------------------------
# JWT signing key
# -----------------------------------------------------------------------------
# Generate a strong random key:
#   PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
#   bash:       openssl rand -base64 48
JWT_SECRET=<paste-base64-of-at-least-48-random-bytes>
JWT_ISSUER=PatientFlow.Auth
JWT_AUDIENCE=PatientFlow.Api


# -----------------------------------------------------------------------------
# AI / LLM (Ollama)
# -----------------------------------------------------------------------------
AI_ENDPOINT=http://host.docker.internal:11434/api/generate
AI_MODEL=llama3.2
AI_EMBEDDING_ENDPOINT=http://host.docker.internal:11434/api/embeddings
AI_EMBEDDING_MODEL=nomic-embed-text


# -----------------------------------------------------------------------------
# Service ports (host-side bindings)
# -----------------------------------------------------------------------------
GATEWAY_PORT=5000
AUTH_PORT=5001
PATIENT_PORT=5002
BILLING_PORT=5003
AI_PORT=5004
