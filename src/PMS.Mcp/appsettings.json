{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithSpan" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            { "key": "service", "value": "mcp" }
          ],
          "propertiesAsLabels": [ "level" ],
          "textFormatter": "Serilog.Sinks.Grafana.Loki.LokiJsonTextFormatter, Serilog.Sinks.Grafana.Loki"
        }
      }
    ]
  },

  "ConnectionStrings": {
    "PatientConnection": "Host=localhost;Port=5432;Database=patientflow_patient;Username=postgres;Password=postgres",
    "BillingConnection": "Host=localhost;Port=5432;Database=patientflow_billing;Username=postgres;Password=postgres",
    "RedisConnection": "localhost:6379"
  },

  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4318"
  },

  "PatientService": {
    "BaseUrl": "http://patient-service:8080",
    "InternalApiKey": ""
  },

  "BillingService": {
    "BaseUrl": "http://billing-service:8080",
    "InternalApiKey": ""
  },

  "AIService": {
    "BaseUrl": "http://ai-service:8080"
  },

  "ApiKeys": {
    "claude-code-key-abc123": "ClaudeCode",
    "claude-desktop-key-xyz789": "ClaudeDesktop"
  }
}
