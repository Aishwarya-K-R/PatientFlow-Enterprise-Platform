{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithSpan" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            { "key": "service", "value": "gateway" }
          ],
          "propertiesAsLabels": [ "level" ],
          "textFormatter": "Serilog.Sinks.Grafana.Loki.LokiJsonTextFormatter, Serilog.Sinks.Grafana.Loki"
        }
      }
    ]
  },

  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "PatientCreatedTopic": "patient-created",
    "PatientUpdatedTopic": "patient-updated",
    "PatientDeletedTopic": "patient-deleted",
    "BillingCreatedTopic": "billing-created"
  },

  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4318"
  },

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "patient-route": {
        "ClusterId": "patient-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/ai/{**catch-all}"
        }
      },
      "mcp-route": {
        "ClusterId": "mcp-cluster",
        "Match": {
          "Path": "/mcp/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "patient-cluster": {
        "Destinations": {
          "patient-service": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "ai-service": {
            "Address": "http://localhost:5004/"
          }
        }
      },
      "mcp-cluster": {
        "Destinations": {
          "mcp-service": {
            "Address": "http://localhost:5005/"
          }
        }
      }
    }
  }
}
