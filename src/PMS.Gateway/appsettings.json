{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },

  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "PatientCreatedTopic": "patient-created",
    "PatientUpdatedTopic": "patient-updated",
    "PatientDeletedTopic": "patient-deleted",
    "BillingCreatedTopic": "billing-created"
  },

  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4318"
  },

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "patient-route": {
        "ClusterId": "patient-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/ai/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "patient-cluster": {
        "Destinations": {
          "patient-service": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "ai-service": {
            "Address": "http://localhost:5004/"
          }
        }
      }
    }
  }
}
