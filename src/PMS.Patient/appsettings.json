{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=patientflow_patient;Username=postgres;Password=postgres",
    "RedisConnection": "localhost:6379"
  },

  "Jwt": {
    "Key": "your-super-secret-jwt-key-min-32-chars-long-please-change-in-production",
    "Issuer": "PatientFlow.Auth",
    "Audience": "PatientFlow.Api"
  },

  "BillingService": {
    "Address": "localhost",
    "Port": "5003"
  },

  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "PatientCreatedTopic": "patient-created",
    "PatientUpdatedTopic": "patient-updated",
    "PatientDeletedTopic": "patient-deleted"
  }
}
