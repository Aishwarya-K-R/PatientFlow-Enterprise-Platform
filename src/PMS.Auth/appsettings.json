{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=patientflow_auth;Username=postgres;Password=postgres"
  },

  "Jwt": {
    "Key": "your-super-secret-jwt-key-min-32-chars-long-please-change-in-production",
    "Issuer": "PatientFlow.Auth",
    "Audience": "PatientFlow.Api"
  }
}
